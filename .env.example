# Change every credential before exposing this service through Cloudflare Tunnel.
DB_NAME=seismo
DB_USER=seismo
DB_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password
JWT_SECRET=replace-with-at-least-32-random-characters
OFFLINE_SECONDS=5
SEED_DEMO_NODES=true
SIM_SPEED=20
SIM_SAMPLE_COUNT=7000

# Group completed detections from different nodes within this time window.
EVENT_ASSOCIATION_WINDOW_SECONDS=10
# Default infrastructure proximity-search radius (not an impact/damage radius).
INFRASTRUCTURE_DEFAULT_RADIUS_KM=5
